{
  "appId": "pro.inmobilia.app",
  "appName": "InmobilIA Pro",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://inmobilia-pro.onrender.com",
    "cleartext": false,
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#3b82f6",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#1e40af"
    }
  },
  "ios": {
    "contentInset": "always"
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true
  }
}
